# Copy this file to .env.local and fill in real values.

# Anthropic API key — required for Claude AI analysis
ANTHROPIC_API_KEY=sk-ant-...

# Neon PostgreSQL connection string — required for storing conversations
# e.g. postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Google Cloud Vision service account JSON, as a single line wrapped in single quotes
GOOGLE_CREDENTIALS_JSON='{"type":"service_account", ...}'
